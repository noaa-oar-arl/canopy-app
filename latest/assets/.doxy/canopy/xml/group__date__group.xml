        <type>subroutine</type>
        <definition>subroutine canopy_date_mod::geth_idts</definition>
        <argsstring>(newdate, olddate, idts)</argsstring>
        <name>geth_idts</name>
        <param>
          <type>newdate</type>
          <defname>newdate</defname>
        </param>
        <param>
          <type>olddate</type>
          <defname>olddate</defname>
        </param>
        <param>
          <type>idts</type>
          <defname>idts</defname>
        </param>
        <briefdescription>
<para>Calculate time difference between two dates. </para>
        </briefdescription>
        <detaileddescription>
<para>Computes the time difference in seconds between two input dates in the format &apos;YYYY-MM-DD HH:MM:SS.ffff&apos;. Handles leap years and different month lengths correctly. <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>newdate</parametername>
</parameternamelist>
<parameterdescription>
<para>The new (later) date string &apos;YYYY-MM-DD HH:MM:SS.ffff&apos; </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>olddate</parametername>
</parameternamelist>
<parameterdescription>
<para>The old (earlier) date string &apos;YYYY-MM-DD HH:MM:SS.ffff&apos; </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>idts</parametername>
</parameternamelist>
<parameterdescription>
<para>Time difference in seconds (newdate - olddate) [output] </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="author"><para>NCAR, T. Otte </para>
</simplesect>
<simplesect kind="date"><para>February 2001, modified 2011 </para>
</simplesect>
</para>
        </detaileddescription>
