        <briefdescription>
<para>Calculate grid cell distances for 1D arrays. </para>
        </briefdescription>
        <detaileddescription>
<para>Computes great circle distance or the orthodromic distance using Haversine formula for 1D latitude/longitude arrays</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">DXOPT</parametername>
</parameternamelist>
<parameterdescription>
<para>User DX calculation option (0=calculate, 1=use set value) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">DXSET</parametername>
</parameternamelist>
<parameterdescription>
<para>User DX set value if cannot calculate (m) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">NLAT</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of latitude grid cells/points </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">NLON</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of longitude grid cells/points </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">LAT</parametername>
</parameternamelist>
<parameterdescription>
<para>Model latitudes array (degrees) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">LON</parametername>
</parameternamelist>
<parameterdescription>
<para>Model longitudes array (degrees) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">DX</parametername>
</parameternamelist>
<parameterdescription>
<para>Distance between two points (m) </para>
</parameterdescription>
</parameteritem>
</parameterlist>
