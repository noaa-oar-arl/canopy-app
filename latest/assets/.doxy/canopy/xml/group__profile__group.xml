      <memberdef kind="function" id="group__profile__group_1ga12df2dbb79549987a7ebfbabbc16d4ae" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>subroutine</type>
        <definition>subroutine canopy_profile_mod::canopy_foliage</definition>
        <argsstring>(MODLAYS, ZHC, ZCANMAX, SIGMAU, SIGMA1, FAFRACZINT)</argsstring>
        <name>canopy_foliage</name>
        <param>
          <type>MODLAYS</type>
          <defname>MODLAYS</defname>
        </param>
        <param>
          <type>ZHC</type>
          <defname>ZHC</defname>
        </param>
        <param>
          <type>ZCANMAX</type>
