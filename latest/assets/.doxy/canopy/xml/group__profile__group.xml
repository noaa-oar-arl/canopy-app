    <title>Canopy Profile Calculations</title>
      <sectiondef kind="user-defined">
      <header>Input Parameters</header>
      <description><para>Determine canopy, fire, and foliage shape distribution parameters</para>
<para>Determines the canopy, fire, and foliage shape distribution parameters based on vegetation type, canopy characteristics, and forest fraction. Maps vegetation types to Massman et al. (2017) forest classifications. <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>VTYPE</parametername>
</parameternamelist>
<parameterdescription>
<para>Grid cell dominant vegetation type </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>FCH</parametername>
</parameternamelist>
<parameterdescription>
<para>Grid cell canopy height (m) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>FFRAC</parametername>
</parameternamelist>
<parameterdescription>
<para>Grid cell forest fraction </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>LAI</parametername>
</parameternamelist>
<parameterdescription>
<para>Grid cell leaf area index </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>PAI_OPT</parametername>
</parameternamelist>
<parameterdescription>
<para>Integer for PAI values used or calculated (default = 0) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>PAI_SET</parametername>
</parameternamelist>
<parameterdescription>
<para>Real value for PAI set values used (default = 4.0) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>LU_OPT</parametername>
</parameternamelist>
<parameterdescription>
<para>Integer for LU type from model mapped to Massman et al. (default = 0/VIIRS) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>FIRETYPE</parametername>
</parameternamelist>
<parameterdescription>
<para>1 = Above Canopy Fire; 0 = Below Canopy Fire; -1 No Canopy [output] </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>CDRAG</parametername>
</parameternamelist>
<parameterdescription>
<para>Drag coefficient (nondimensional) [output] </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>PAI</parametername>
</parameternamelist>
<parameterdescription>
<para>Plant/foliage area index (nondimensional) [output] </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>ZCANMAX</parametername>
</parameternamelist>
<parameterdescription>
<para>Height of maximum foliage area density (z/h) (nondimensional) [output] </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>SIGMAU</parametername>
</parameternamelist>
<parameterdescription>
<para>Standard deviation of shape function above zcanmax (z/h) [output] </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>SIGMA1</parametername>
</parameternamelist>
<parameterdescription>
<para>Standard deviation of shape function below zcanmax (z/h) [output] </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="author"><para>P.C. Campbell </para>
</simplesect>
<simplesect kind="date"><para>June 2022 </para>
</simplesect>
<simplesect kind="note"><para>Based on Massman et al. (2017) algorithms </para>
</simplesect>
</para>
</description>
